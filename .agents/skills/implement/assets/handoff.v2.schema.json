{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:handoff:v2",
  "allOf": [
    {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2"},
    {
      "type": "object",
      "required": ["metadata", "h1", "sections", "local_ids", "references", "placeholders"],
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "type", "sources", "snapshot_at"],
          "properties": {
            "schema_version": {"const": 2},
            "id": {
              "anyOf": [
                {"type": "string", "pattern": "^HANDOFF-[0-9]+$"},
                {"const": "HANDOFF-<NNN>"}
              ]
            },
            "type": {"const": "handoff"},
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "anyOf": [
                  {"type": "string", "pattern": "^PLAN-[0-9]+#TASK-[0-9]+$"},
                  {"const": "PLAN-<PLAN>#TASK-<TASK>"}
                ]
              }
            },
            "snapshot_at": {
              "anyOf": [
                {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
                {"const": "<SNAPSHOT-AT>"}
              ]
            }
          }
        },
        "h1": {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2#/$defs/non_empty_string"},
        "sections": {"const": ["Baseline and working-tree state", "Current task", "Objective last progress", "Exact checks and results", "Agent topology and roles", "Consumed limits", "Stop reason", "Risks and blockers", "Next safe action"]},
        "local_ids": {"type": "array", "maxItems": 0},
        "references": {
          "type": "array",
          "items": {"type": "string", "pattern": "^PLAN-[0-9]+#TASK-[0-9]+$"}
        },
        "placeholders": {"type": "array"}
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:task-graph:v2",
  "allOf": [
    {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2"},
    {
      "type": "object",
      "required": ["metadata", "h1", "sections", "local_ids", "references", "placeholders"],
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "type", "sources", "namespace"],
          "properties": {
            "schema_version": {"const": 2},
            "id": {
              "anyOf": [
                {"type": "string", "pattern": "^TASKS-[0-9]+$"},
                {"const": "TASKS-<NNN>"}
              ]
            },
            "type": {"const": "task-graph"},
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "anyOf": [
                  {"type": "string", "pattern": "^PLAN-[0-9]+$"},
                  {"const": "PLAN-<NNN>"}
                ]
              }
            },
            "namespace": {
              "anyOf": [
                {"type": "string", "pattern": "^PLAN-[0-9]+$"},
                {"const": "PLAN-<NNN>"}
              ]
            }
          }
        },
        "h1": {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2#/$defs/non_empty_string"},
        "sections": {
          "type": "array",
          "minItems": 5,
          "items": {
            "anyOf": [
              {"enum": ["Execution controls", "Tasks", "Change contract", "Coverage"]},
              {"type": "string", "pattern": "^TASK-[0-9]+: [^\\u0000-\\u001F\\u007F]+$"}
            ]
          }
        },
        "local_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": {"const": "task"},
              "id": {"type": "string", "pattern": "^TASK-[0-9]+$"}
            }
          }
        },
        "references": {"type": "array"},
        "placeholders": {"type": "array"}
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:specification:v2",
  "allOf": [
    {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2"},
    {
      "type": "object",
      "required": ["metadata", "h1", "sections", "local_ids", "references", "placeholders"],
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "type", "sources", "status", "depends_on"],
          "properties": {
            "schema_version": {"const": 2},
            "id": {
              "anyOf": [
                {"type": "string", "pattern": "^SPEC-[0-9]+$"},
                {"const": "SPEC-<NNN>"}
              ]
            },
            "type": {"const": "specification"},
            "sources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2#/$defs/non_empty_string"}
            },
            "status": {"enum": ["draft", "approved", "implemented", "verified"]},
            "depends_on": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^SPEC-[0-9]+$"}
            },
            "children": {
              "type": "array",
              "items": {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2#/$defs/fragment_child"}
            }
          }
        },
        "h1": {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2#/$defs/non_empty_string"},
        "sections": {"const": ["Context", "Confirmed rationale", "Outcome", "Actors and scenarios", "Scope", "In scope", "Out of scope", "Requirements", "Business rules", "Failure behavior and edge cases", "Quality constraints", "Dependencies and confirmed constraints", "Acceptance criteria", "Open questions"]},
        "local_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "id"],
                "properties": {
                  "kind": {"const": "requirement"},
                  "id": {"type": "string", "pattern": "^REQ-[0-9]+$"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "id"],
                "properties": {
                  "kind": {"const": "acceptance-criterion"},
                  "id": {"type": "string", "pattern": "^AC-[0-9]+$"}
                }
              }
            ]
          }
        },
        "references": {"type": "array"},
        "placeholders": {"type": "array"}
      }
    }
  ]
}

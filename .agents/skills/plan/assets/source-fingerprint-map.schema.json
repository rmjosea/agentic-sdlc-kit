{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:source-fingerprint-map:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "source_revision", "item_revisions"],
  "properties": {
    "schema_version": {"const": 2},
    "source_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?$"},
    "source_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "item_revisions": {
      "type": "object",
      "not": {"const": {}},
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    }
  }
}

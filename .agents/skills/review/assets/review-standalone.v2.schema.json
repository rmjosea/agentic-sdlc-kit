{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:review-standalone:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "h1", "sections", "local_ids", "references", "placeholders"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "type", "sources", "verdict"],
      "properties": {
        "schema_version": {"const": 2},
        "id": {"anyOf": [{"type": "string", "minLength": 8, "maxLength": 100, "pattern": "^REVIEW-[0-9]+$"}, {"const": "REVIEW-<N>"}]},
        "type": {"const": "review-report"},
        "sources": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}},
        "verdict": {"enum": ["approved", "changes-required", "blocked"]}
      }
    },
    "h1": {"type": "string", "minLength": 1, "maxLength": 500},
    "sections": {"type": "array", "minItems": 11, "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "local_ids": {"const": []},
    "references": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}},
    "placeholders": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}}
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]+$"}
  }
}

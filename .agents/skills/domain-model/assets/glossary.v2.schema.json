{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:domain-context:v2",
  "allOf": [
    {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2"},
    {
      "type": "object",
      "required": ["metadata", "h1", "sections", "local_ids", "references", "placeholders"],
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "type", "sources", "status"],
          "properties": {
            "schema_version": {"const": 2},
            "id": {
              "anyOf": [
                {"type": "string", "pattern": "^GLOSSARY-[0-9]+$"},
                {"const": "GLOSSARY-<NNN>"}
              ]
            },
            "type": {"const": "domain-context"},
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2#/$defs/non_empty_string"}
            },
            "status": {"enum": ["draft", "active", "archived"]}
          }
        },
        "h1": {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2#/$defs/non_empty_string"},
        "sections": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1001,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {"const": "Terms"},
              {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^`\\u0000-\\u001F\\u007F]+$"}
            ]
          }
        },
        "local_ids": {"const": []},
        "references": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {"type": "string", "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?#REQ-[0-9]+$"},
              {"type": "string", "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?#AC-[0-9]+$"},
              {"type": "string", "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?#TASK-[0-9]+$"}
            ]
          }
        },
        "placeholders": {"type": "array", "maxItems": 1000}
      }
    }
  ]
}

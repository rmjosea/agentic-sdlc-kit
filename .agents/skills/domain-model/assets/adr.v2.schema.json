{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:architecture-decision:v2",
  "allOf": [
    {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2"},
    {
      "type": "object",
      "required": ["metadata", "h1", "sections", "local_ids", "references", "placeholders"],
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "type", "sources", "status", "date", "supersedes", "superseded_by"],
          "properties": {
            "schema_version": {"const": 2},
            "id": {
              "anyOf": [
                {"type": "string", "pattern": "^ADR-[0-9]+$"},
                {"const": "ADR-<NNN>"}
              ]
            },
            "type": {"const": "architecture-decision"},
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {"$ref": "urn:agentic-sdlc-kit:markdown-document:v2#/$defs/non_empty_string"}
            },
            "status": {"enum": ["proposed", "accepted", "deprecated", "superseded"]},
            "date": {
              "anyOf": [
                {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                {"const": "<YYYY-MM-DD>"}
              ]
            },
            "supersedes": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^ADR-[0-9]+$"}
            },
            "superseded_by": {
              "anyOf": [
                {"type": "string", "pattern": "^ADR-[0-9]+$"},
                {"type": "null"}
              ]
            }
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "superseded"}}},
              "then": {"properties": {"superseded_by": {"type": "string", "pattern": "^ADR-[0-9]+$"}}},
              "else": {"properties": {"superseded_by": {"type": "null"}}}
            }
          ]
        },
        "h1": {
          "anyOf": [
            {"type": "string", "minLength": 7, "maxLength": 500, "pattern": "^ADR-[0-9]+: [^\\u0000-\\u001F\\u007F]+$"},
            {"const": "ADR-<NNN>: <decision title>"}
          ]
        },
        "sections": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["Context", "Decision", "Alternatives", "Confirmed rationale", "Repository evidence", "Agent inference", "Unknowns", "Consequences"]
          }
        },
        "local_ids": {"const": []},
        "references": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {"type": "string", "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?#REQ-[0-9]+$"},
              {"type": "string", "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?#AC-[0-9]+$"},
              {"type": "string", "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?#TASK-[0-9]+$"}
            ]
          }
        },
        "placeholders": {"type": "array", "maxItems": 1000}
      }
    }
  ]
}

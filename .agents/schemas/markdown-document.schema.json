{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:markdown-document:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "h1",
    "sections",
    "local_ids",
    "references",
    "placeholders"
  ],
  "properties": {
    "metadata": {"$ref": "#/$defs/metadata"},
    "h1": {"$ref": "#/$defs/non_empty_string"},
    "sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "local_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/local_id"}
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {"type": "string", "maxLength": 500, "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?#REQ-[0-9]+$"},
          {"type": "string", "maxLength": 500, "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?#AC-[0-9]+$"},
          {"type": "string", "maxLength": 500, "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?#TASK-[0-9]+$"},
          {"type": "string", "maxLength": 500, "pattern": "^REQ-[0-9]+$"},
          {"type": "string", "maxLength": 500, "pattern": "^AC-[0-9]+$"},
          {"type": "string", "maxLength": 500, "pattern": "^TASK-[0-9]+$"}
        ]
      }
    },
    "placeholders": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/non_empty_string"}
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "safe_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\u0000-\\u001F\\u007F]+$"
    },
    "artifact_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?$"
        },
        {"type": "string", "pattern": "^[A-Z]+-<[A-Z]+>$"},
        {"type": "string", "pattern": "^<[A-Z]+(?:-[A-Z]+)*>$"}
      ]
    },
    "digest": {
      "anyOf": [
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        {"type": "string", "pattern": "^sha256:<[A-Z]+(?:-[A-Z]+)*>$"}
      ]
    },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "source_items"],
      "properties": {
        "source_revision": {"$ref": "#/$defs/digest"},
        "source_items": {"$ref": "#/$defs/safe_path"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "type", "sources"],
      "properties": {
        "schema_version": {"const": 2},
        "id": {"$ref": "#/$defs/artifact_id"},
        "type": {"$ref": "#/$defs/name"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "status": {"$ref": "#/$defs/name"},
        "parent": {"$ref": "#/$defs/artifact_id"},
        "fragment_id": {"$ref": "#/$defs/artifact_id"},
        "children": {
          "type": "array",
          "items": {"$ref": "#/$defs/fragment_child"}
        },
        "namespace": {"$ref": "#/$defs/artifact_id"},
        "source_revisions": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/source_revision"}
        },
        "risk": {"enum": ["low", "medium", "high"]},
        "risk_rationale": {"$ref": "#/$defs/non_empty_string"},
        "date": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            {"const": "<YYYY-MM-DD>"}
          ]
        },
        "supersedes": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ADR-[0-9]+$"
          }
        },
        "superseded_by": {
          "anyOf": [
            {"type": "string", "pattern": "^ADR-[0-9]+$"},
            {"type": "null"}
          ]
        },
        "snapshot_at": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            {"const": "<SNAPSHOT-AT>"}
          ]
        },
        "verdict": {"enum": ["approved", "changes-required", "blocked"]},
        "evidence_reference": {"$ref": "#/$defs/non_empty_string"},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact_id"}
        }
      }
    },
    "fragment_child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/artifact_id"},
        "path": {"$ref": "#/$defs/safe_path"}
      }
    },
    "local_id": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"$ref": "#/$defs/name"},
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]+$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:kit-catalog:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kit_version",
    "skill_groups",
    "modules",
    "global_resources",
    "profiles"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kit_version": {"const": "2.1.0"},
    "skill_groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "utilities", "optional"],
      "properties": {
        "core": {"$ref": "#/$defs/names"},
        "utilities": {"$ref": "#/$defs/names"},
        "optional": {"$ref": "#/$defs/names"}
      }
    },
    "modules": {
      "type": "array",
      "items": {"$ref": "#/$defs/module"}
    },
    "global_resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safe_path"}
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "full"],
      "properties": {
        "default": {"$ref": "#/$defs/profile"},
        "full": {"$ref": "#/$defs/profile"}
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "names": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "safe_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\u0000-\\u001F\\u007F]+$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "depends_on"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"$ref": "#/$defs/non_empty_string"},
        "depends_on": {"$ref": "#/$defs/names"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "modules"],
      "properties": {
        "skills": {"$ref": "#/$defs/names"},
        "modules": {"$ref": "#/$defs/names"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:evidence:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "change_id", "authoritative_sources", "lifecycle", "risk", "change_contract", "repository_scope", "source_seals", "requirement_coverage", "quality_signals", "checks", "review", "known_limits", "remaining_risks", "follow_ups"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "minLength": 10, "maxLength": 100, "pattern": "^EVIDENCE-[0-9]+$"},
    "change_id": {"$ref": "#/$defs/global_id"},
    "authoritative_sources": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "risk": {"$ref": "#/$defs/risk"},
    "change_contract": {"$ref": "#/$defs/change_contract"},
    "repository_scope": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/repository_scope"}},
    "source_seals": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/source_seal"}},
    "requirement_coverage": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/coverage"}},
    "quality_signals": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/quality_signal"}},
    "checks": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/check"}},
    "review": {"$ref": "#/$defs/review"},
    "known_limits": {"oneOf": [{"const": "not-tracked"}, {"$ref": "#/$defs/string_array"}]},
    "remaining_risks": {"$ref": "#/$defs/string_array"},
    "follow_ups": {"$ref": "#/$defs/string_array"}
  },
  "allOf": [
    {
      "if": {"properties": {"review": {"properties": {"verdict": {"const": "approved"}}}}},
      "then": {"properties": {"lifecycle": {"properties": {"status": {"const": "complete"}}}}}
    },
    {
      "if": {"properties": {"lifecycle": {"properties": {"status": {"const": "complete"}}}}},
      "then": {"properties": {"lifecycle": {"properties": {"transition": {"enum": ["implemented", "verified"]}}}, "review": {"properties": {"verdict": {"const": "approved"}}}}},
      "else": {"properties": {"lifecycle": {"properties": {"transition": {"const": "not-requested"}}}, "review": {"properties": {"verdict": {"enum": ["changes-required", "blocked"]}}}}}
    }
  ],
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]+$"},
    "global_id": {"type": "string", "minLength": 3, "maxLength": 100, "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?$"},
    "nullable_string": {"oneOf": [{"$ref": "#/$defs/non_empty_string"}, {"type": "null"}]},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "immutable_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "string_array": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "reference"],
      "properties": {"id": {"$ref": "#/$defs/global_id"}, "reference": {"$ref": "#/$defs/non_empty_string"}}
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "transition", "evidence_references"],
      "properties": {
        "status": {"enum": ["in-progress", "blocked", "complete"]},
        "transition": {"enum": ["not-requested", "implemented", "verified"]},
        "evidence_references": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {"level": {"enum": ["low", "medium", "high"]}, "rationale": {"$ref": "#/$defs/non_empty_string"}}
    },
    "change_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["intent", "confirmed_why", "scope", "expected_evidence", "agent_roles", "review_focus"],
      "properties": {
        "intent": {"$ref": "#/$defs/non_empty_string"},
        "confirmed_why": {"$ref": "#/$defs/non_empty_string"},
        "scope": {"$ref": "#/$defs/non_empty_string"},
        "expected_evidence": {"$ref": "#/$defs/string_array"},
        "agent_roles": {"$ref": "#/$defs/string_array"},
        "review_focus": {"$ref": "#/$defs/string_array"}
      }
    },
    "repository_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_id", "base", "head", "committed_range", "uncommitted_entries", "snapshot_sha256"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/non_empty_string"},
        "base": {"oneOf": [{"$ref": "#/$defs/immutable_revision"}, {"const": "not-applicable"}, {"type": "null"}]},
        "head": {"oneOf": [{"$ref": "#/$defs/immutable_revision"}, {"const": "not-applicable"}, {"type": "null"}]},
        "committed_range": {"$ref": "#/$defs/nullable_string"},
        "uncommitted_entries": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/uncommitted_entry"}},
        "snapshot_sha256": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "uncommitted_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "state", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/non_empty_string"},
        "state": {"enum": ["staged", "unstaged", "untracked"]},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_seal": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "overall_digest", "item_digests"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/global_id"},
        "overall_digest": {"$ref": "#/$defs/digest"},
        "item_digests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "repository_ids", "status", "implementation_references", "evidence_references"],
      "properties": {
        "requirement_id": {"type": "string", "minLength": 7, "maxLength": 500, "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?#[A-Z]+-[0-9]+$"},
        "repository_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}},
        "status": {"enum": ["covered", "partial", "not-covered"]},
        "implementation_references": {"$ref": "#/$defs/string_array"},
        "evidence_references": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}}
      }
    },
    "quality_signal": {
      "type": "object", "additionalProperties": false,
      "required": ["signal", "disposition", "trigger", "evidence_references"],
      "properties": {
        "signal": {"enum": ["Correctness", "Security", "Compatibility", "Maintainability", "Performance", "Accessibility", "Observability", "Cost", "Understandability"]},
        "disposition": {"enum": ["selected", "N/A"]},
        "trigger": {"$ref": "#/$defs/non_empty_string"},
        "evidence_references": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "selected"}}}, "then": {"properties": {"evidence_references": {"minItems": 1}}}, "else": {"properties": {"evidence_references": {"maxItems": 0}}}}
      ]
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "requirement_ids", "repository_ids", "kind", "required", "applicability", "not_applicable_reason", "status", "observed_result", "evidence_class", "output_reference"],
      "properties": {
        "id": {"$ref": "#/$defs/non_empty_string"},
        "requirement_ids": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 7, "maxLength": 500, "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?#[A-Z]+-[0-9]+$"}},
        "repository_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}},
        "kind": {"enum": ["scoped", "regression", "failure-path", "recovery-rollback", "static", "other"]},
        "required": {"type": "boolean"},
        "applicability": {"enum": ["applicable", "not-applicable"]},
        "not_applicable_reason": {"$ref": "#/$defs/nullable_string"},
        "status": {"enum": ["passed", "failed", "skipped", "not-run", "not-applicable"]},
        "observed_result": {"$ref": "#/$defs/nullable_string"},
        "evidence_class": {"oneOf": [{"enum": ["observed evidence", "source-based inference", "unverified claim"]}, {"type": "null"}]},
        "output_reference": {"$ref": "#/$defs/nullable_string"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["passed", "failed"]}}}, "then": {"properties": {"observed_result": {"$ref": "#/$defs/non_empty_string"}, "evidence_class": {"const": "observed evidence"}}}},
        {"if": {"properties": {"status": {"enum": ["skipped", "not-run"]}}}, "then": {"properties": {"observed_result": {"type": "null"}, "evidence_class": {"type": "null"}, "output_reference": {"type": "null"}}}},
        {"if": {"properties": {"applicability": {"const": "not-applicable"}}}, "then": {"properties": {"required": {"const": false}, "not_applicable_reason": {"$ref": "#/$defs/non_empty_string"}, "status": {"const": "not-applicable"}, "observed_result": {"type": "null"}, "evidence_class": {"type": "null"}, "output_reference": {"type": "null"}}}, "else": {"properties": {"not_applicable_reason": {"type": "null"}, "status": {"enum": ["passed", "failed", "skipped", "not-run"]}}}}
      ]
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_role", "reviewer_id", "implementers", "prior_participation", "fresh_context", "independence", "independence_basis", "verdict", "reference"],
      "properties": {
        "reviewer_role": {"$ref": "#/$defs/non_empty_string"},
        "reviewer_id": {"$ref": "#/$defs/non_empty_string"},
        "implementers": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}},
        "prior_participation": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"enum": ["implementation", "planning", "validation", "review", "other"]}},
        "fresh_context": {"type": "boolean"},
        "independence": {"enum": ["self-review", "independent"]},
        "independence_basis": {"$ref": "#/$defs/non_empty_string"},
        "verdict": {"enum": ["approved", "changes-required", "blocked"]},
        "reference": {"$ref": "#/$defs/non_empty_string"}
      },
      "allOf": [
        {"if": {"properties": {"independence": {"const": "independent"}}}, "then": {"properties": {"fresh_context": {"const": true}}}}
      ]
    }
  }
}

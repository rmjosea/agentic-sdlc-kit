{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:evidence:v1",
  "title": "Agentic SDLC change evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "authoritative_sources",
    "lifecycle",
    "risk",
    "change_contract",
    "repository_scope",
    "requirement_coverage",
    "checks",
    "review",
    "known_limits",
    "remaining_risks",
    "follow_ups"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "change_id": {"$ref": "#/$defs/non_empty_string"},
    "authoritative_sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "risk": {"$ref": "#/$defs/risk"},
    "change_contract": {"$ref": "#/$defs/change_contract"},
    "repository_scope": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repository_scope"}
    },
    "requirement_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/coverage"}
    },
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    },
    "review": {"$ref": "#/$defs/review"},
    "known_limits": {
      "oneOf": [
        {"const": "not-tracked"},
        {"$ref": "#/$defs/string_array"}
      ]
    },
    "remaining_risks": {"$ref": "#/$defs/string_array"},
    "follow_ups": {"$ref": "#/$defs/string_array"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {"properties": {"verdict": {"const": "approved"}}}
        }
      },
      "then": {
        "properties": {
          "lifecycle": {"properties": {"status": {"const": "complete"}}}
        }
      }
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "nullable_string": {
      "oneOf": [
        {"$ref": "#/$defs/non_empty_string"},
        {"type": "null"}
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "immutable_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "string_array": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reference"],
      "properties": {
        "id": {"$ref": "#/$defs/non_empty_string"},
        "reference": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "transition", "evidence_references"],
      "properties": {
        "status": {"enum": ["in-progress", "blocked", "complete"]},
        "transition": {"enum": ["not-requested", "implemented", "verified"]},
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/non_empty_string"}
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "rationale": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "change_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "confirmed_why",
        "scope",
        "expected_evidence",
        "agent_roles",
        "review_focus"
      ],
      "properties": {
        "intent": {"$ref": "#/$defs/non_empty_string"},
        "confirmed_why": {"$ref": "#/$defs/non_empty_string"},
        "scope": {"$ref": "#/$defs/non_empty_string"},
        "expected_evidence": {"$ref": "#/$defs/string_array"},
        "agent_roles": {"$ref": "#/$defs/string_array"},
        "review_focus": {"$ref": "#/$defs/string_array"}
      }
    },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "base",
        "head",
        "committed_range",
        "uncommitted_entries",
        "snapshot_sha256"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/non_empty_string"},
        "base": {
          "oneOf": [
            {"$ref": "#/$defs/immutable_revision"},
            {"const": "not-applicable"},
            {"type": "null"}
          ]
        },
        "head": {
          "oneOf": [
            {"$ref": "#/$defs/immutable_revision"},
            {"const": "not-applicable"},
            {"type": "null"}
          ]
        },
        "committed_range": {"$ref": "#/$defs/nullable_string"},
        "uncommitted_entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/uncommitted_entry"}
        },
        "snapshot_sha256": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "uncommitted_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/non_empty_string"},
        "state": {"enum": ["staged", "unstaged", "untracked"]},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "repository_ids",
        "status",
        "implementation_references",
        "evidence_references"
      ],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/non_empty_string"},
        "repository_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "status": {"enum": ["covered", "partial", "not-covered"]},
        "implementation_references": {"$ref": "#/$defs/string_array"},
        "evidence_references": {"$ref": "#/$defs/string_array"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement_ids",
        "repository_ids",
        "kind",
        "required",
        "applicability",
        "not_applicable_reason",
        "status",
        "observed_result",
        "evidence_class",
        "output_reference"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/non_empty_string"},
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "repository_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "kind": {
          "enum": [
            "scoped",
            "regression",
            "failure-path",
            "recovery-rollback",
            "static",
            "other"
          ]
        },
        "required": {"type": "boolean"},
        "applicability": {"enum": ["applicable", "not-applicable"]},
        "not_applicable_reason": {"$ref": "#/$defs/nullable_string"},
        "status": {
          "enum": ["passed", "failed", "skipped", "not-run", "not-applicable"]
        },
        "observed_result": {"$ref": "#/$defs/nullable_string"},
        "evidence_class": {
          "oneOf": [
            {"enum": ["observed evidence", "source-based inference", "unverified claim"]},
            {"type": "null"}
          ]
        },
        "output_reference": {"$ref": "#/$defs/nullable_string"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["passed", "failed"]}}},
          "then": {
            "properties": {
              "observed_result": {"$ref": "#/$defs/non_empty_string"},
              "evidence_class": {"const": "observed evidence"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["skipped", "not-run"]}}},
          "then": {
            "properties": {
              "observed_result": {"type": "null"},
              "evidence_class": {"type": "null"},
              "output_reference": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"applicability": {"const": "not-applicable"}}},
          "then": {
            "properties": {
              "required": {"const": false},
              "not_applicable_reason": {"$ref": "#/$defs/non_empty_string"},
              "status": {"const": "not-applicable"},
              "observed_result": {"type": "null"},
              "evidence_class": {"type": "null"},
              "output_reference": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "not_applicable_reason": {"type": "null"},
              "status": {"enum": ["passed", "failed", "skipped", "not-run"]}
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_role",
        "reviewer_id",
        "implementers",
        "prior_participation",
        "fresh_context",
        "independence",
        "independence_basis",
        "verdict",
        "reference"
      ],
      "properties": {
        "reviewer_role": {"$ref": "#/$defs/nullable_string"},
        "reviewer_id": {"$ref": "#/$defs/nullable_string"},
        "implementers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "prior_participation": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["implementation", "planning", "validation", "review", "other"]}
        },
        "fresh_context": {"type": "boolean"},
        "independence": {"enum": ["self-review", "independent", "not-reviewed"]},
        "independence_basis": {"$ref": "#/$defs/nullable_string"},
        "verdict": {"enum": ["approved", "changes-required", "blocked", "not-reviewed"]},
        "reference": {"$ref": "#/$defs/nullable_string"}
      },
      "allOf": [
        {
          "if": {"properties": {"independence": {"const": "independent"}}},
          "then": {
            "properties": {
              "fresh_context": {"const": true},
              "prior_participation": {
                "not": {"contains": {"const": "implementation"}}
              },
              "independence_basis": {"$ref": "#/$defs/non_empty_string"}
            }
          }
        },
        {
          "if": {"properties": {"independence": {"const": "self-review"}}},
          "then": {
            "properties": {
              "prior_participation": {"contains": {"const": "implementation"}}
            }
          }
        }
      ]
    }
  }
}

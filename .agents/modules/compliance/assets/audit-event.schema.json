{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:compliance-audit-event:v1",
  "title": "Agentic SDLC compliance audit event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "timestamp",
    "change_id",
    "actor",
    "action",
    "previous_lifecycle",
    "new_lifecycle",
    "authoritative_source_references",
    "evidence_references",
    "approvals",
    "repositories"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"$ref": "#/$defs/non_empty_string"},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "change_id": {"$ref": "#/$defs/non_empty_string"},
    "actor": {"$ref": "#/$defs/actor"},
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "previous_lifecycle": {"$ref": "#/$defs/nullable_lifecycle"},
    "new_lifecycle": {"$ref": "#/$defs/nullable_lifecycle"},
    "authoritative_source_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "approvals": {
      "type": "array",
      "items": {"$ref": "#/$defs/approval"}
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repository"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "lifecycle-transition"}}},
      "then": {
        "properties": {
          "previous_lifecycle": {"$ref": "#/$defs/lifecycle"},
          "new_lifecycle": {"$ref": "#/$defs/lifecycle"}
        }
      },
      "else": {
        "properties": {
          "previous_lifecycle": {"type": "null"},
          "new_lifecycle": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "lifecycle": {
      "enum": ["draft", "approved", "planned", "implemented", "verified"]
    },
    "nullable_lifecycle": {
      "oneOf": [
        {"$ref": "#/$defs/lifecycle"},
        {"type": "null"}
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "role"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/non_empty_string"},
        "role": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "role", "reference"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/non_empty_string"},
        "role": {"$ref": "#/$defs/non_empty_string"},
        "reference": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "revision"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/non_empty_string"},
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        }
      }
    }
  }
}

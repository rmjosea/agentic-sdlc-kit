{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc-kit:compliance-audit-event:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "sequence", "timestamp", "change_id", "actor", "action", "previous_lifecycle", "new_lifecycle", "authoritative_source_references", "evidence_references", "approvals", "repositories"],
  "properties": {
    "schema_version": {"const": 2},
    "event_id": {"type": "string", "minLength": 7, "maxLength": 100, "pattern": "^EVENT-[0-9]+$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "change_id": {"$ref": "#/$defs/global_id"},
    "actor": {"$ref": "#/$defs/actor"},
    "action": {"enum": ["evidence-updated", "lifecycle-transition", "review-recorded", "approval-recorded", "check-recorded", "task-state-changed", "change-started"]},
    "previous_lifecycle": {"$ref": "#/$defs/nullable_lifecycle"},
    "new_lifecycle": {"$ref": "#/$defs/nullable_lifecycle"},
    "authoritative_source_references": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}},
    "evidence_references": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}},
    "approvals": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/approval"}},
    "repositories": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/repository"}}
  },
  "allOf": [
    {"if": {"properties": {"action": {"const": "lifecycle-transition"}}}, "then": {"properties": {"previous_lifecycle": {"$ref": "#/$defs/lifecycle"}, "new_lifecycle": {"$ref": "#/$defs/lifecycle"}}}, "else": {"properties": {"previous_lifecycle": {"type": "null"}, "new_lifecycle": {"type": "null"}}}}
  ],
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]+$"},
    "global_id": {"type": "string", "minLength": 3, "maxLength": 100, "pattern": "^[A-Z]+-[0-9]+(?:-[A-Z]+-[0-9]+)?$"},
    "lifecycle": {"enum": ["draft", "approved", "implemented", "verified"]},
    "nullable_lifecycle": {"oneOf": [{"$ref": "#/$defs/lifecycle"}, {"type": "null"}]},
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "role"],
      "properties": {"actor_id": {"$ref": "#/$defs/non_empty_string"}, "role": {"$ref": "#/$defs/non_empty_string"}}
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "role", "reference"],
      "properties": {"actor_id": {"$ref": "#/$defs/non_empty_string"}, "role": {"$ref": "#/$defs/non_empty_string"}, "reference": {"$ref": "#/$defs/non_empty_string"}}
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_id", "revision"],
      "properties": {"repository_id": {"$ref": "#/$defs/non_empty_string"}, "revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}}
    }
  }
}
